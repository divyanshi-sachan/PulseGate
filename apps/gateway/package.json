{
  "name": "@pulsegate/gateway",
  "version": "0.0.0",
  "private": true,
  "description": "PulseGate gateway server (data plane and operations listener)",
  "type": "module",
  "exports": {
    ".": {
      "@pulsegate/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --conditions=@pulsegate/source --watch src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@pulsegate/cache": "workspace:*",
    "@pulsegate/config": "workspace:*",
    "@pulsegate/observability": "workspace:*",
    "@pulsegate/rate-limiter": "workspace:*",
    "@pulsegate/reliability": "workspace:*",
    "@pulsegate/shared": "workspace:*",
    "fastify": "5.12.7",
    "ioredis": "6.0.0",
    "undici": "8.12.3"
  },
  "devDependencies": {
    "@pulsegate/testing": "workspace:*"
  }
}
