{
  "name": "@pulsegate/mock-upstreams",
  "version": "0.0.0",
  "private": true,
  "description": "Mock upstream HTTP service with fault injection for PulseGate development and tests",
  "type": "module",
  "exports": {
    ".": {
      "@pulsegate/source": "./src/index.ts",
