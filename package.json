{
  "name": "pulsegate",
  "version": "0.0.0",
  "private": true,
  "description": "PulseGate \u2014 API gateway and reliability platform",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/dashboard/tsconfig.json && tsc -p tests/e2e/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "clean": "pnpm -r exec rm -rf dist",
    "dev:up": "docker compose up --build",
    "dev:down": "docker compose down",
    "keygen": "node --conditions=@pulsegate/source apps/gateway/src/keygen.ts",
    "dev:distributed": "docker compose -f docker-compose.yml -f docker-compose.distributed.yml up --build",
    "dev:distributed:down": "docker compose -f docker-compose.yml -f docker-compose.distributed.yml down",
    "test:mutations": "node scripts/mutation-check.ts",
    "bench:stats": "node --expose-gc --conditions=@pulsegate/source scripts/bench-stats-window.ts",
    "bundle:check": "node scripts/check-bundle.ts",
    "dev:dashboard": "docker compose -f docker-compose.yml -f docker-compose.dashboard.yml up --build",
    "dev:dashboard:down": "docker compose -f docker-compose.yml -f docker-compose.dashboard.yml down",
    "test:e2e": "scripts/e2e.sh"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@pulsegate/observability": "workspace:*",
    "@testcontainers/redis": "12.2.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "testcontainers": "12.2.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
