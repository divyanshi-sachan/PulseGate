{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "apps/*/src/**/*.ts",
    "apps/*/test/**/*.ts",
    "packages/*/test/**/*.ts",
    "packages/*/src/**/*.ts",
    "examples/*/src/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "*.config.ts"
  ]
}
